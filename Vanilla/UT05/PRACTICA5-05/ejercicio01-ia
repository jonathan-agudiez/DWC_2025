// ==========================
//   PARTE 0: ESTRUCTURA
// ==========================
const CLAVE_LS = "coleccionDiscos";

// Estructura del objeto JSON:
// { discos: [ { id, nombre, caratula, grupo, anio, genero, localizacion, prestado }, ... ] }
let coleccion = { discos: [] };

// Estado del filtro actual
let filtroActual = "";

// ==========================
//   UTILIDADES LOCALSTORAGE
// ==========================
function cargarDesdeLocalStorage() {
  const datos = localStorage.getItem(CLAVE_LS);
  if (datos) {
    try {
      coleccion = JSON.parse(datos);
      if (!coleccion.discos) {
        coleccion = { discos: Array.isArray(coleccion) ? coleccion : [] };
      }
    } catch (e) {
      console.error("Error parseando localStorage:", e);
      coleccion = { discos: [] };
    }
  }
}

function guardarEnLocalStorage() {
  localStorage.setItem(CLAVE_LS, JSON.stringify(coleccion));
}

// ==========================
//   VALIDACIONES (PARTE II)
// ==========================
const form = document.getElementById("form-disco");
const inputNombre = document.getElementById("nombre");
const inputCaratula = document.getElementById("caratula");
const inputGrupo = document.getElementById("grupo");
const inputAnio = document.getElementById("anio");
const selectGenero = document.getElementById("genero");
const inputLocalizacion = document.getElementById("localizacion");
const checkboxPrestado = document.getElementById("prestado");
const contErrores = document.getElementById("mensaje-errores");

function limpiarErrores() {
  contErrores.classList.remove("activo");
  contErrores.innerHTML = "";
  [inputNombre, inputGrupo, inputAnio, selectGenero, inputLocalizacion].forEach((el) =>
    el.classList.remove("campo-error")
  );
}

function marcarError(campo, mensaje, listaMensajes) {
  campo.classList.add("campo-error");
  listaMensajes.push(mensaje);
}

function validarFormulario() {
  limpiarErrores();
  const errores = [];

  const nombre = inputNombre.value.trim();
  const grupo = inputGrupo.value.trim();
  const anio = inputAnio.value.trim();
  const genero = selectGenero.value;
  const localizacion = inputLocalizacion.value.trim();

  // Nombre del disco
  if (nombre.length < 5) {
    marcarError(
      inputNombre,
      "➤ El nombre del disco es obligatorio y debe tener al menos 5 caracteres.",
      errores
    );
  }

  // Grupo / intérprete
  if (grupo.length < 5) {
    marcarError(
      inputGrupo,
      "➤ El grupo o intérprete es obligatorio y debe tener al menos 5 caracteres.",
      errores
    );
  }

  // Año de publicación: 4 dígitos numéricos
  const regexAnio = /^\d{4}$/;
  if (!regexAnio.test(anio)) {
    marcarError(
      inputAnio,
      "➤ El año de publicación debe tener exactamente 4 dígitos numéricos (ejemplo: 1999).",
      errores
    );
  }

  // Género
  if (genero === "") {
    marcarError(selectGenero, "➤ Debes seleccionar un género musical.", errores);
  }

  // Localización ES-001AA (001 = números, AA = letras mayúsculas)
  const regexLocalizacion = /^ES-\d{3}[A-Z]{2}$/;
  if (!regexLocalizacion.test(localizacion)) {
    marcarError(
      inputLocalizacion,
      "➤ La localización debe tener el formato ES-001AA (tres dígitos y dos letras mayúsculas).",
      errores
    );
  }

  if (errores.length > 0) {
    contErrores.classList.add("activo");
    contErrores.innerHTML =
      "<strong>Ups… hay errores en el formulario:</strong>" +
      "<ul><li>" +
      errores.join("</li><li>") +
      "</li></ul>";
    return false;
  }

  return true;
}

// Quitar la marca de error al corregir los campos
[inputNombre, inputGrupo, inputAnio, selectGenero, inputLocalizacion].forEach((campo) => {
  campo.addEventListener("input", () => {
    if (campo.classList.contains("campo-error")) {
      validarFormulario();
    }
  });
  campo.addEventListener("change", () => {
    if (campo.classList.contains("campo-error")) {
      validarFormulario();
    }
  });
});

// ==========================
//   GESTIÓN DE DISCO (I, IV)
// ==========================
function crearDiscoDesdeFormulario() {
  return {
    id: Date.now(), // identificador sencillo
    nombre: inputNombre.value.trim(),
    caratula: inputCaratula.value.trim(),
    grupo: inputGrupo.value.trim(),
    anio: inputAnio.value.trim(),
    genero: selectGenero.value,
    localizacion: inputLocalizacion.value.trim(),
    prestado: checkboxPrestado.checked,
  };
}

function limpiarFormulario() {
  form.reset();
  limpiarErrores();
}

function agregarDisco() {
  if (!validarFormulario()) return;

  const disco = crearDiscoDesdeFormulario();
  coleccion.discos.push(disco);
  guardarEnLocalStorage();
  renderizarListado();
  limpiarFormulario();
}

function eliminarDisco(id) {
  const disco = coleccion.discos.find((d) => d.id === id);
  const nombre = disco ? disco.nombre : "este disco";

  const confirmar = window.confirm(
    `¿Seguro que quieres eliminar "${nombre}" de la colección?`
  );
  if (!confirmar) return;

  coleccion.discos = coleccion.discos.filter((d) => d.id !== id);
  guardarEnLocalStorage();
  renderizarListado();
}

// ==========================
//   LISTADO (I, III, IV)
// ==========================
const rejillaDiscos = document.getElementById("rejilla-discos");
const textoListadoVacio = document.getElementById("listado-vacio");

function obtenerDiscosFiltrados() {
  const texto = filtroActual.trim().toLowerCase();
  if (!texto) return coleccion.discos;

  return coleccion.discos.filter(
    (disco) =>
      disco.nombre.toLowerCase().includes(texto) ||
      disco.grupo.toLowerCase().includes(texto)
  );
}

function renderizarListado() {
  const discos = obtenerDiscosFiltrados();
  rejillaDiscos.innerHTML = "";

  if (discos.length === 0) {
    textoListadoVacio.style.display = "block";
    return;
  } else {
    textoListadoVacio.style.display = "none";
  }

  discos.forEach((disco) => {
    const tarjeta = document.createElement("article");
    tarjeta.className = "tarjeta-disco";

    const img = document.createElement("img");
    img.alt = `Carátula de ${disco.nombre}`;
    img.src =
      disco.caratula ||
      "https://via.placeholder.com/400x300?text=Sin+car%C3%A1tula";

    img.onerror = () => {
      img.src =
        "https://via.placeholder.com/400x300?text=Sin+car%C3%A1tula";
    };

    const cuerpo = document.createElement("div");
    cuerpo.className = "tarjeta-cuerpo";

    const titulo = document.createElement("div");
    titulo.className = "titulo-disco";
    titulo.textContent = disco.nombre;

    const grupo = document.createElement("div");
    grupo.className = "grupo-disco";
    grupo.textContent = disco.grupo;

    const info = document.createElement("small");
    info.textContent = `${disco.anio} · ${disco.genero}`;

    const loc = document.createElement("div");
    loc.textContent = `Localización: ${disco.localizacion}`;

    const badges = document.createElement("div");
    badges.className = "badges";
    if (disco.prestado) {
      const badgePrestado = document.createElement("span");
      badgePrestado.className = "badge badge-prestado";
      badgePrestado.textContent = "Prestado";
      badges.appendChild(badgePrestado);
    }

    cuerpo.appendChild(titulo);
    cuerpo.appendChild(grupo);
    cuerpo.appendChild(info);
    cuerpo.appendChild(loc);
    cuerpo.appendChild(badges);

    const footer = document.createElement("div");
    footer.className = "tarjeta-footer";

    const textoId = document.createElement("span");
    textoId.textContent = `ID: ${disco.id}`;

    const btnEliminar = document.createElement("button");
    btnEliminar.className = "btn-eliminar";
btnEliminar.innerHTML = `
  <svg xmlns="http://www.w3.org/2000/svg"
       fill="none"
       viewBox="0 0 24 24"
       stroke-width="1.5"
       stroke="currentColor"
       class="icon">
    <path stroke-linecap="round" stroke-linejoin="round"
          d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
  </svg>
`;
    btnEliminar.addEventListener("click", () => eliminarDisco(disco.id));

    footer.appendChild(textoId);
    footer.appendChild(btnEliminar);

    tarjeta.appendChild(img);
    tarjeta.appendChild(cuerpo);
    tarjeta.appendChild(footer);

    rejillaDiscos.appendChild(tarjeta);
  });
}

// ==========================
//   BUSCADOR (III)
// ==========================
const inputBuscador = document.getElementById("buscador");
const btnBuscar = document.getElementById("btn-buscar");
const btnLimpiar = document.getElementById("btn-limpiar");

function aplicarFiltro() {
  filtroActual = inputBuscador.value || "";
  renderizarListado();
}

function limpiarFiltro() {
  filtroActual = "";
  inputBuscador.value = "";
  renderizarListado();
}

// ==========================
//   EVENTOS (I, III, IV, V)
// ==========================
document.addEventListener("DOMContentLoaded", () => {
  cargarDesdeLocalStorage();
  renderizarListado();
});

const btnGuardar = document.getElementById("btn-guardar");
const btnMostrar = document.getElementById("btn-mostrar");

btnGuardar.addEventListener("click", agregarDisco);
btnMostrar.addEventListener("click", renderizarListado);

btnBuscar.addEventListener("click", aplicarFiltro);
btnLimpiar.addEventListener("click", limpiarFiltro);

// Búsqueda mientras se escribe
inputBuscador.addEventListener("input", () => {
  filtroActual = inputBuscador.value;
  renderizarListado();
});
